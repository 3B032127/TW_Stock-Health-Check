# 台股每日盤後排程（本機時區需為 Asia/Taipei；週一至週五）
# 14:35 先更新日 K 線並驗證最新交易日覆蓋率；未達標 exit 2
35 14 * * 1-5 cd /Users/xin/.gemini/antigravity/scratch/TW_Stock-Health-Check && ./scripts/run_daily_pipeline.sh update >> /tmp/tw_update.log 2>&1
# 14:40 確認資料已就緒後才執行雙模型預測 (--mode daily)
40 14 * * 1-5 cd /Users/xin/.gemini/antigravity/scratch/TW_Stock-Health-Check && ./scripts/run_daily_pipeline.sh predict >> /tmp/tw_predict.log 2>&1
